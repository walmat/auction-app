{
	"name": "interview-auctions",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "npm run test:api && npm run test:browser",
		"test:api": "npm test --prefix server/typescript",
		"test:browser": "playwright test",
		"typecheck": "tsc -b && tsc --noEmit -p server/typescript/tsconfig.json && tsc -p tsconfig.tests.json"
	},
	"dependencies": {
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-router-dom": "^7.18.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@playwright/test": "^1.63.0",
		"@types/node": "^22.20.4",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1"
	}
}
